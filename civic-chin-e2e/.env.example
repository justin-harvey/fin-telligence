# ---------------------------------------------------------------------------
# CivicChain E2E — environment configuration
# Copy to `.env` and fill in. `.env` is gitignored; never commit real secrets.
# ---------------------------------------------------------------------------

# Base URL of the running app. On your laptop this is usually a localhost port;
# against the shared box it's the app host. Point it wherever the app is served.
BASE_URL=https://app.civic-chin.com

# Public verify page (used by verify.spec.ts). Relative to BASE_URL if it starts
# with "/", otherwise treated as absolute.
VERIFY_PATH=/public/verify

# Mail catch-all — all outbound mail from the test env is routed here.
MAIL_URL=https://mail.civic-chin.com

# ---------------------------------------------------------------------------
# Accounts. These are TEST accounts on a TEST environment. Passwords live here
# only so specs don't hardcode them — rotate freely, this file is an example.
# ---------------------------------------------------------------------------

# CivicChain platform / civic admin
CIVIC_ADMIN_EMAIL=super@civicchain.io
CIVIC_ADMIN_PASSWORD=CivicAdminTest!2026

# Testville municipality
MUNI_ADMIN_EMAIL=atv@atv.com
MUNI_ADMIN_PASSWORD=password
MUNI_EMPLOYEE_EMAIL=wilee@acme.com
MUNI_EMPLOYEE_PASSWORD=password

# Vendor: Acme Inc.
ACME_ADMIN_EMAIL=joe@acme.com
ACME_ADMIN_PASSWORD=password
ACME_EMPLOYEE_EMAIL=wilee@acme.com
ACME_EMPLOYEE_PASSWORD=password

# Vendor: Tyrell Corporation
TYRELL_ADMIN_EMAIL=Eldon@Tyrell.com
TYRELL_ADMIN_PASSWORD=password
TYRELL_EMPLOYEE_EMAIL=roy@Tyrell.com
TYRELL_EMPLOYEE_PASSWORD=password

# Key-backup passphrase (only needed if a signing step decrypts the *.enc keys).
KEY_PASSPHRASE=CivicChainRules
