# Copy to .env and fill in, or run `ant auth login` instead.
#
# Only the planner and narrator need this. The guard, the database, the
# lineage record and the audit chain all work without any credential —
# `fintel explain` and `npm test` run offline.
ANTHROPIC_API_KEY=

# --- PostgreSQL (optional) -------------------------------------------------
#
# Unset, everything runs on the bundled SQLite demo warehouse. Set, the same
# pipeline runs against Postgres and the Postgres tests stop skipping.
#
# The read-only role the query path uses. This is the only one the pipeline
# needs, and `fintel warehouse` will prove it cannot write.
DATABASE_URL=

# Admin connection, used only by `fintel mirror-postgres` to build the demo
# warehouse. Never used by the query path.
FINTEL_ADMIN_DATABASE_URL=

# A deliberately writable role, used only by the test that confirms the
# read-only check can actually fail. Not needed to run the tool.
DATABASE_URL_WRITABLE=
